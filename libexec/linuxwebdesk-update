#!/usr/bin/env bash
# Apply an update. Installed to /usr/local/libexec/linuxwebdesk-update.
#
# Launched two ways: by the web UI (as the transient systemd unit
# `linuxwebdesk-update`, so it survives the restart of the service it is
# updating), or by hand as `sudo linuxwebdesk-update`.
#
# It does no fetching or building of its own. That is bootstrap.sh's job, and
# running the same script the installer runs is the point -- an update is just
# an install over the top. What this adds is the bookkeeping the browser needs:
# a lock, a log, and a status file that outlives the restart.
set -euo pipefail

CONF=${LWD_CONF:-/etc/linuxwebdesk/install.conf}
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

REPO=${LWD_REPO:-HutsonLabs/LinuxWebDesk}
REF=${LWD_REF:-main}
SRC_DIR=${LWD_SRC_DIR:-/usr/local/src/linuxwebdesk}
STATE=${LWD_STATE_DIR:-/var/lib/linuxwebdesk}
ACTOR=${LWD_UPDATE_ACTOR:-$(id -un)}
FROM=${LWD_UPDATE_FROM:-}

[ "$(id -u)" -eq 0 ] || { echo "!! must run as root" >&2; exit 1; }

mkdir -p "$STATE"
chmod 0700 "$STATE"
LOG=$STATE/update.log

# One update at a time, whichever way it was started. The web path is already
# serialised by systemd refusing a duplicate unit name; this covers the rest.
if command -v flock >/dev/null 2>&1; then
  exec 9>"$STATE/update.lock"
  flock -n 9 || { echo "!! another update is already running" >&2; exit 1; }
fi

# Started by hand: show the work as well as recording it.
if [ -t 1 ]; then
  exec > >(tee -a "$LOG") 2>&1
else
  exec >>"$LOG" 2>&1
fi

PHASE=starting
STARTED=$(date +%s)
TO=
TMP=

# Escape a value for embedding in the JSON below: backslashes, quotes, and any
# control character that would make the file unparseable.
jesc() {
  printf '%s' "${1-}" \
    | tr -d '\000-\010\013\014\016-\037' \
    | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' \
    | tr '\n\r\t' '   '
}

# Written by rename, never in place, so a poll from the daemon cannot catch a
# half-written file.
write_status() {
  state=$1
  err=${2:-}
  if [ "$state" = running ]; then finished=null; else finished=$(date +%s); fi
  tmp=$STATE/update.status.new
  cat >"$tmp" <<EOF
{
  "state": "$(jesc "$state")",
  "phase": "$(jesc "$PHASE")",
  "started": $STARTED,
  "finished": $finished,
  "actor": "$(jesc "$ACTOR")",
  "repo": "$(jesc "$REPO")",
  "ref": "$(jesc "$REF")",
  "from": "$(jesc "$FROM")",
  "to": "$(jesc "$TO")",
  "error": "$(jesc "$err")"
}
EOF
  mv -f "$tmp" "$STATE/update.status"
}

on_exit() {
  rc=$?
  [ -n "$TMP" ] && rm -rf "$TMP"
  if [ "$rc" -eq 0 ]; then
    echo
    echo "==> update complete: now at ${TO:-unknown}"
    write_status ok
  else
    echo
    echo "!! update failed during '$PHASE' (exit $rc)"
    write_status failed "failed during '$PHASE' (exit $rc)"
  fi
}
trap on_exit EXIT

if [ -z "$FROM" ] && [ -r "$SRC_DIR/.lwd-source" ]; then
  FROM=$(sed -n 's/^commit=//p' "$SRC_DIR/.lwd-source" | head -1)
fi

echo "=== linuxwebdesk update $(date -Is) — requested by $ACTOR"
echo "    repo=$REPO ref=$REF src=$SRC_DIR from=${FROM:-unknown}"
write_status running

# --- get an installer to run ------------------------------------------------
# Whatever installer we end up with, it runs from $TMP and never from $SRC_DIR.
# bootstrap.sh replaces the contents of $SRC_DIR including itself, and bash
# reads a script incrementally as it executes, so running the very file that is
# about to be rewritten underneath it is a real hazard.
PHASE=preparing
write_status running
TMP=$(mktemp -d)

# Fetch the installer for the tracked ref rather than reusing the copy on disk.
# That copy is the one the *previous* update installed, so preferring it meant
# every change to install or update behaviour took two runs to take effect: the
# first wrote the new script, and only the second was run by it. An update is
# defined as installing the tracked ref over the top, so the installer should
# come from that ref too, not from whatever the last one happened to leave.
#
# This is not new trust. bootstrap.sh is already fetched from this repo on a
# first install, and the tree it goes on to install comes from the same origin
# over the same TLS -- see "How privileges work" in the README.
echo "==> fetching bootstrap.sh from $REPO@$REF"
if curl -fsSL --max-time 60 \
     "https://raw.githubusercontent.com/$REPO/$REF/bootstrap.sh" \
     -o "$TMP/bootstrap.sh.new" \
   && [ -s "$TMP/bootstrap.sh.new" ] \
   && head -1 "$TMP/bootstrap.sh.new" | grep -q '^#!'; then
  # Checked for a shebang rather than just a 200: a captive portal or a proxy
  # that answers with an HTML error page would otherwise be run as root.
  mv "$TMP/bootstrap.sh.new" "$TMP/bootstrap.sh"
elif [ -f "$SRC_DIR/bootstrap.sh" ]; then
  # Offline, or GitHub is having a day. The copy on disk still installs the
  # source already sitting in $SRC_DIR, which beats refusing to run at all.
  echo "    could not fetch it; falling back to $SRC_DIR/bootstrap.sh"
  cp "$SRC_DIR/bootstrap.sh" "$TMP/bootstrap.sh"
else
  echo "!! could not fetch bootstrap.sh and there is no copy on disk" >&2
  exit 1
fi
chmod +x "$TMP/bootstrap.sh"

# --- run it -----------------------------------------------------------------
# No FORCE_BUILD any more. bootstrap.sh deletes the previous binary before it
# decides what to do, so the stale-binary hazard that flag existed for is gone
# -- and forcing a build would discard the verified release binary it may have
# just fetched.
PHASE=installing
write_status running
echo "==> running the installer"
LWD_REPO=$REPO \
LWD_REF=$REF \
LWD_SRC_DIR=$SRC_DIR \
  bash "$TMP/bootstrap.sh"

# --- record where we landed -------------------------------------------------
PHASE=recording
write_status running
if [ -r "$SRC_DIR/.lwd-source" ]; then
  TO=$(sed -n 's/^commit=//p' "$SRC_DIR/.lwd-source" | head -1)
fi
